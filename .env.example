# Required environment variables for PO Reconciliation Assistant

# ── Backend ───────────────────────────────────────────────────────────────────
# Groq API key — used by the LangGraph agent (llama-3.3-70b-versatile).
# Get your free key at https://console.groq.com
GROQ_API_KEY=gsk_...

# Optional: override the Groq model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: path to the SQLite database file (default: ./po_reconciliation.db)
# DB_PATH=./po_reconciliation.db

# ── Frontend ──────────────────────────────────────────────────────────────────
# Backend API base URL used by the React app (default: http://localhost:8000)
# VITE_API_URL=http://localhost:8000
